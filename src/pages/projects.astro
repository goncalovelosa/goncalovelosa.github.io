---
// projects.astro - Projects listing page
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'YieldRadar',
    description: 'DeFi yield intelligence with multi-factor risk scoring. Monitors 18K+ pools across 6 chains and pushes risk-adjusted alerts to Telegram. Built with TypeScript, Redis caching, and real-time APY normalization.',
    tags: ['TypeScript', 'DeFi', 'Telegram', 'Redis', 'Node.js'],
    category: 'DeFi',
    github: 'https://github.com/goncalovelosa/yield-radar',
    stars: null,
    icon: 'chart',
    live: 'https://yieldradar.io'
  },
  {
    title: 'agents-md-creator',
    description: 'CLI tool that generates optimized AGENTS.md files for AI coding agents (Claude Code, Codex, Cursor, Aider). Detects project structure, validates against best practices, and uses progressive disclosure.',
    tags: ['TypeScript', 'CLI', 'AI Tools', 'DX'],
    category: 'Open Source',
    github: 'https://github.com/goncalovelosa/agents-md-creator',
    stars: null,
    icon: 'code',
    live: null
  },
  {
    title: 'Modular Perps Primitives',
    description: 'Open-source composable building blocks for perpetual futures protocols on EVM chains. Positioned as "OpenZeppelin for Perps" — independent modules for oracles, margin, funding rates, and liquidations. MIT licensed, Foundry-native.',
    tags: ['Solidity', 'Foundry', 'DeFi', 'EVM'],
    category: 'DeFi Infra',
    github: null,
    stars: null,
    icon: 'block',
    live: null,
    status: 'In Research'
  },
  {
    title: 'Hermes Skills',
    description: 'Collection of custom skills for Hermes Agent — autonomous AI coding workflows, DeFi yield bot operations, GitHub issue management, and multi-agent orchestration patterns.',
    tags: ['AI Agents', 'TypeScript', 'Automation'],
    category: 'AI',
    github: 'https://github.com/goncalovelosa/hermes-skills',
    stars: null,
    icon: 'brain',
    live: null
  }
];

const iconMap: Record<string, string> = {
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  chart: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  text: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  block: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  brain: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'
};
---

<BaseLayout title="Projects | Gonçalo Velosa">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 md:py-24">
    <!-- Header -->
    <header class="mb-16">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-on-surface mb-4">
        Projects<span class="text-primary">.</span>
      </h1>
      <p class="text-xl text-on-surface-variant max-w-2xl">
        Things I've built, am building, or researching. Focused on DeFi infrastructure, developer tools, and AI agents.
      </p>
    </header>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <article class="card group cursor-pointer flex flex-col">
          <!-- Header -->
          <div class="flex items-start justify-between mb-4">
            <div class="p-3 bg-surface-container-high rounded-lg">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconMap[project.icon]} />
              </svg>
            </div>
            <div class="flex items-center gap-2">
              {project.status && (
                <span class="text-xs font-label text-primary bg-primary/10 px-3 py-1 rounded-full">
                  {project.status}
                </span>
              )}
              <span class="text-xs font-label text-on-surface-variant bg-surface-container-highest px-3 py-1 rounded-full">
                {project.category}
              </span>
            </div>
          </div>

          <!-- Title -->
          <h2 class="text-xl font-bold text-on-surface mb-3 group-hover:text-primary transition-colors">
            {project.title}
          </h2>

          <!-- Description -->
          <p class="text-on-surface-variant mb-4 flex-grow">
            {project.description}
          </p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-4">
            {project.tags.map((tag) => (
              <span class="text-xs font-label text-on-surface-variant bg-surface-container-highest px-3 py-1 rounded-full">
                {tag}
              </span>
            ))}
          </div>

          <!-- Footer -->
          <div class="flex items-center justify-between pt-4 border-t border-outline-variant/10">
            <div class="flex items-center gap-4">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  GitHub
                </a>
              )}
              {project.live && (
                <a
                  href={project.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  Live
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
